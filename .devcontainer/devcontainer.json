{
  "name": "Mobile Cloud Development Workspace",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "pnpmVersion": "10"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [3000, 3001, 4000, 5000, 8000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Next.js",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "3001": {
      "label": "Alternative web preview",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "4000": {
      "label": "NestJS / Express API",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "5000": {
      "label": "Python API",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8000": {
      "label": "Python web app",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8080": {
      "label": "Additional service",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "Prisma.prisma",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.copilot",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "vscode"
}
